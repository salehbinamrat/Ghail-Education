<Application x:Class="SchoolObservatory.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#008DB3"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#EAF8FC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#133A56"/>
    <SolidColorBrush x:Key="TurquoiseBrush" Color="#00AFC0"/>
    <SolidColorBrush x:Key="DeepBlueBrush" Color="#086AA3"/>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="BorderBrush" Value="#9ACBD9"/>
      <Setter Property="Foreground" Value="#133A56"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="5"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="FlowDirection" Value="RightToLeft"/>
      <Setter Property="RowHeight" Value="35"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="4,14"/>
      <Setter Property="AlternatingRowBackground" Value="#F2F6FC"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
  </Application.Resources>
</Application>

<Window FontFamily="Arial" x:Class="SchoolObservatory.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المرصد المدرسي — التهيئة الأولى"
        Width="690" Height="680" MinWidth="470" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded" Background="#EAF8FC" FlowDirection="RightToLeft">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="80"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="20,15" Background="#086AA3">
      <StackPanel>
        <TextBlock Text="المرصد المدرسي" Foreground="White" FontWeight="Bold" FontSize="25"/>
        <TextBlock Text="التهيئة الأولى — إنشاء المسؤول المؤسس وإعداد المديرية"
                   Foreground="#DDFBFF" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="White" BorderBrush="#CDEBF2" BorderThickness="1,0,1,0" Padding="20,8">
      <ScrollViewer x:Name="SetupFieldsScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
        <StackPanel Margin="0,4,8,6">
          <TextBlock Text="اسم المديرية" FontWeight="SemiBold"/>
          <TextBox x:Name="DistrictBox" MaxLength="120" AutomationProperties.Name="اسم المديرية"/>
          <TextBlock Text="السنة الدراسية (مثال: 2026/2027)" Margin="0,12,0,0" FontWeight="SemiBold"/>
          <TextBox x:Name="YearBox" Text="2026/2027" MaxLength="9"
                   FlowDirection="LeftToRight" HorizontalContentAlignment="Right"
                   AutomationProperties.Name="السنة الدراسية"/>
          <TextBlock Text="اسم مستخدم المسؤول (بالإنجليزية)" Margin="0,12,0,0" FontWeight="SemiBold"/>
          <TextBox x:Name="UsernameBox" FlowDirection="LeftToRight" MaxLength="64"
                   AutomationProperties.Name="اسم مستخدم المسؤول"/>
          <TextBlock Text="كلمة المرور (12 حرفا على الأقل، أحرف وأرقام)" Margin="0,12,0,0"
                     FontWeight="SemiBold" TextWrapping="Wrap"/>
          <PasswordBox x:Name="PasswordInput" MaxLength="128"
                       AutomationProperties.Name="كلمة مرور المسؤول"/>
          <TextBlock Text="تأكيد كلمة المرور" Margin="0,12,0,0" FontWeight="SemiBold"/>
          <PasswordBox x:Name="ConfirmInput" MaxLength="128"
                       AutomationProperties.Name="تأكيد كلمة المرور"/>
          <TextBlock Text="لا توجد كلمة مرور افتراضية. بيانات الحساب تحددها أنت، ولا تظهر هذه الخطوة بعد نجاح الإنشاء."
                     TextWrapping="Wrap" Foreground="#526A78" Margin="0,14,0,4" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Keep both actions visible outside the scrollable form, even on small screens and high DPI. -->
    <Border Grid.Row="2" CornerRadius="0,0,14,14" Background="White" BorderBrush="#CDEBF2"
            BorderThickness="1,0,1,1" Padding="18,8,18,12">
      <StackPanel>
        <Button x:Name="CreateAdministratorButton" Content="إنشاء المسؤول الأول والمتابعة"
                Click="Create_Click" Height="44" FontWeight="Bold" Background="#00AFC0"
                AutomationProperties.Name="إنشاء المسؤول الأول"/>
        <Button x:Name="ExistingLoginButton" Content="لدي حساب بالفعل — تسجيل الدخول"
                Click="ExistingLogin_Click" Height="40" Background="#126AA7"
                AutomationProperties.Name="تسجيل الدخول بحساب موجود"/>
        <TextBlock Text="بعد إنشاء المسؤول الأول ستظهر شاشة تسجيل الدخول تلقائيا."
                   TextAlignment="Center" TextWrapping="Wrap" Foreground="#526A78" FontSize="12"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>

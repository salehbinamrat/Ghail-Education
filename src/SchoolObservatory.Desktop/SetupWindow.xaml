<Window x:Class="SchoolObservatory.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المرصد المدرسي — التهيئة الأولى" Width="530" Height="590"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F7FB" FlowDirection="RightToLeft">
  <Border Margin="26" Padding="30" Background="White" CornerRadius="16">
    <StackPanel>
      <TextBlock Text="المرصد المدرسي" FontWeight="Bold" FontSize="25" Foreground="#1565C0"/>
      <TextBlock Text="إنشاء المسؤول الأول وإعداد المديرية" FontSize="15" Margin="0,8,0,18"/>
      <TextBlock Text="اسم المديرية"/>
      <TextBox x:Name="DistrictBox"/>
      <TextBlock Text="السنة الدراسية (مثال: 2026/2027)" Margin="0,8,0,0"/>
      <TextBox x:Name="YearBox" Text="2026/2027" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
      <TextBlock Text="اسم مستخدم المسؤول (بالإنجليزية)" Margin="0,8,0,0"/>
      <TextBox x:Name="UsernameBox" FlowDirection="LeftToRight"/>
      <TextBlock Text="كلمة المرور (12 حرفا على الأقل، أحرف وأرقام)" Margin="0,8,0,0"/>
      <PasswordBox x:Name="PasswordInput"/>
      <TextBlock Text="تأكيد كلمة المرور" Margin="0,8,0,0"/>
      <PasswordBox x:Name="ConfirmInput"/>
      <TextBlock Text="لا توجد كلمة مرور افتراضية. ستظهر هذه الشاشة مرة واحدة فقط." TextWrapping="Wrap" Foreground="#64748B" Margin="0,10"/>
      <Button Content="إنشاء النظام والمتابعة" Click="Create_Click" Margin="0,14,0,0"/>
    </StackPanel>
  </Border>
</Window>

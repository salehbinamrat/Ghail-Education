<Window x:Class="SchoolObservatory.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول — المرصد المدرسي"
        Width="550" Height="475" MinWidth="420" MinHeight="360"
        Background="#EAF8FC" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded"
        FlowDirection="RightToLeft">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="95"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="21,16" Background="#086AA3">
      <StackPanel>
        <TextBlock Text="المرصد المدرسي" FontSize="25" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="تسجيل الدخول — إدارة الإحصاء المدرسي بالمديرية"
                   Margin="0,5,0,0" FontSize="14" Foreground="#DBFAFF" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Padding="22,12" Background="White" BorderBrush="#CDEBF2"
            BorderThickness="1,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,5,0">
          <TextBlock Text="اسم المستخدم" FontWeight="SemiBold" Margin="0,6"/>
          <TextBox x:Name="UsernameBox" MaxLength="64" FlowDirection="LeftToRight"
                   AutomationProperties.Name="اسم المستخدم"/>
          <TextBlock Text="كلمة المرور" FontWeight="SemiBold" Margin="0,15,0,6"/>
          <PasswordBox x:Name="PasswordInput" MaxLength="128" KeyDown="PasswordInput_KeyDown"
                       AutomationProperties.Name="كلمة المرور"/>
          <TextBlock x:Name="ErrorText" Foreground="#B42338" TextWrapping="Wrap"
                     Margin="3,10,3,3" FontSize="13"
                     AutomationProperties.LiveSetting="Assertive"/>
          <TextBlock Text="تُفتح أقسام البرنامج وفق صلاحيات هذا الحساب."
                     TextWrapping="Wrap" Foreground="#526A78" Margin="0,12,0,4"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Padding="18,10" CornerRadius="0,0,14,14" Background="White"
            BorderBrush="#CDEBF2" BorderThickness="1,0,1,1">
      <StackPanel>
        <Button x:Name="LoginButton" Content="تسجيل الدخول" Click="Login_Click"
                Height="46" FontWeight="Bold" Background="#00AFC0"
                AutomationProperties.Name="تسجيل الدخول"/>
        <TextBlock Text="إذا كان هذا أول تشغيل للبرنامج، أنشئ حساب المسؤول الأول أولا."
                   TextAlignment="Center" TextWrapping="Wrap" Foreground="#526A78" FontSize="12"
                   Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>

<Window x:Class="SchoolObservatory.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول — المرصد المدرسي" Width="490" Height="430"
        Background="#F4F7FB" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft">
  <Border Margin="28" Padding="28" Background="White" CornerRadius="16">
    <StackPanel>
      <TextBlock Text="المرصد المدرسي" FontSize="27" FontWeight="Bold" Foreground="#1565C0"/>
      <TextBlock Text="نظام إدارة الإحصاء المدرسي بالمديرية" Margin="0,6,0,24" FontSize="14" Foreground="#64748B"/>
      <TextBlock Text="اسم المستخدم"/>
      <TextBox x:Name="UsernameBox" FlowDirection="LeftToRight"/>
      <TextBlock Text="كلمة المرور" Margin="0,12,0,0"/>
      <PasswordBox x:Name="PasswordInput" KeyDown="PasswordInput_KeyDown"/>
      <Button Content="تسجيل الدخول" Click="Login_Click" Margin="0,20,0,0"/>
      <TextBlock Text="تُفتح الأقسام بحسب الدور والصلاحية الممنوحة للمستخدم." TextWrapping="Wrap" Foreground="#64748B" Margin="0,16,0,0"/>
    </StackPanel>
  </Border>
</Window>

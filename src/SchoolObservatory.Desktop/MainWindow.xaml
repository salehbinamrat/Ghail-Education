<Window x:Class="SchoolObservatory.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المرصد المدرسي" Width="1240" Height="800" MinWidth="1040" MinHeight="670"
        Background="#F4F7FB" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#12335B" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="5,12,5,20">
          <TextBlock Text="المرصد المدرسي" Foreground="White" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="نظام إحصاء المديرية" Foreground="#BFD6F1" FontSize="13" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="AccountText" Foreground="#DCEAF8" TextWrapping="Wrap" Margin="12"/>
          <Button Content="خروج" Click="Logout_Click" Background="#B3263E"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavPanel"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="White" BorderBrush="#E1E8F2" BorderThickness="0,0,0,1" Padding="22,14">
        <DockPanel>
          <TextBlock x:Name="SectionTitle" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="YearText" DockPanel.Dock="Left" Foreground="#53708F" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="ContentHost" Margin="22,20"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

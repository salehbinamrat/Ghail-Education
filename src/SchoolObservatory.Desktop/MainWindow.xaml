<Window FontFamily="Arial" FontWeight="Bold" x:Class="SchoolObservatory.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المرصد المدرسي" Width="1240" Height="800" MinWidth="770" MinHeight="540"
        Background="#EAF8FC" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#07527E" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="5,12,5,20">
          <TextBlock Text="المرصد المدرسي" Foreground="White" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="نظام إحصاء المديرية" Foreground="#CDFBFF" FontSize="13" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="AccountText" Foreground="#E1F9FF" TextWrapping="Wrap" Margin="12"/>
          <Button Content="تسجيل خروج" Click="Logout_Click" Background="#B3263E"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavPanel"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="White" BorderBrush="#D5EAF2" BorderThickness="0,0,0,1" Padding="18,14">
        <Grid x:Name="HeaderLayout" FlowDirection="RightToLeft">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SectionTitle" Grid.Column="0" FontSize="22" FontWeight="Bold"
                     VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <TextBlock x:Name="YearText" Grid.Column="1" Foreground="#0B7198"
                     MaxWidth="230" TextWrapping="Wrap" TextAlignment="Left"
                     VerticalAlignment="Center" FontWeight="Bold"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="ContentHost" Margin="16,14"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
